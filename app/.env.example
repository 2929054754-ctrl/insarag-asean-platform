# ---- DeepSeek LLM (required for RAG answer / translation streaming) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# ---- BigModel (Zhipu) embeddings ----
# EMBEDDING_BACKEND: auto | bigmodel | local   (default auto)
#   auto     -> BigModel when BIGMODEL_API_KEY is set, else local
#   bigmodel -> force BigModel; on any failure falls back to local (state logged)
#   local    -> force local sentence-transformers (TF-IDF if model unusable)
EMBEDDING_BACKEND=
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=
BIGMODEL_EMBED_MODEL=
# embedding-3 supports a dimensions parameter. 512 keeps the full index ~6MB so
# the prebuilt app.db can be bundled into serverless functions. Changing this
# value requires a CLEAN rebuild: python scripts/build_index.py --wipe
BIGMODEL_EMBEDDING_DIM=512

# ---- Local sentence-transformers model (fallback) ----
EMBEDDING_MODEL_NAME=

# ---- Serverless deployment ----
# The prebuilt app.db (produced by scripts/build_index.py) is bundled with the
# function. Cold start only LOADS it (read-only FS -> copied to /tmp). Do NOT
# set REBUILD_ON_START on serverless: re-embedding ~thousands of slices on a
# cold start would time out. Keep REBUILD_ON_START only for local dev.
REBUILD_ON_START=0
# Optional Turso / libSQL remote database (pip install libsql).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- RAG guardrail ----
# Minimum cosine score to answer. Below this the endpoint returns a refuse
# event and does NOT call the LLM (no token spent). Calibrated on embedding-3
# dim=512: off-domain questions top out ~0.48, relevant questions start ~0.61,
# so 0.5 separates them cleanly.
RAG_MIN_SCORE=0.5
